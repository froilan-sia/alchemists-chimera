finance:LCR rdfs:label "finance:LCR" ;
    chimera:confidence "0.95"^^xsd:float ;
    chimera:evidence "Authorized institutions must maintain a Liquidity Coverage Ratio of at least 100%. The LCR ensures that banks have sufficient high-quality liquid assets to withstand a 30-day stress scenario." ;
    chimera:pageNumber 2 ;
    chimera:requirementOf chimera:6 ;
    chimera:sourceDocument "hkma_capital_requirements.pdf" ;
    chimera:sourceSha256 "8301fa6f35a18c48dd87fef9fa592d06e7c60d248c16d05f394a19afa2d44b55" .

finance:NSFR rdfs:label "finance:NSFR" ;
    chimera:confidence "0.95"^^xsd:float ;
    chimera:evidence "Banks must maintain a Net Stable Funding Ratio of at least 100%. The NSFR promotes resilience over a longer time horizon by requiring stable funding relative to the liquidity profile of assets." ;
    chimera:pageNumber 2 ;
    chimera:requirementOf chimera:6 ;
    chimera:sourceDocument "hkma_capital_requirements.pdf" ;
    chimera:sourceSha256 "8301fa6f35a18c48dd87fef9fa592d06e7c60d248c16d05f394a19afa2d44b55" .

