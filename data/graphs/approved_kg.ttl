###############################################################################
# Regulatory Relationships
###############################################################################

:HKMA :requiresApproval :HKMA_Capital_Adequacy ;
    :requiresApproval :HKMA_LCR ;
    :requiresApproval :HKMA_NSFR .

:BaselCommittee :requiresApproval :BaselIII_CET1 ;
    :requiresApproval :BaselIII_Tier1 ;
    :requiresApproval :BaselIII_TotalCapital ;
    :requiresApproval :BaselIII_ConservationBuffer .

:HSBC_HK :hasCapitalRatio :HSBC_HK_CET1 ;
    :hasCapitalRatio :HSBC_HK_Tier1 ;
    :hasCapitalRatio :HSBC_HK_Leverage .

:StandardChartered_HK :hasCapitalRatio :StandardChartered_HK_CET1 .

:BankOfChina_HK :hasCapitalRatio :BankOfChina_HK_CET1 .

