###############################################################################
# HKMA Regulatory Framework (From HKMA Supervisory Policy Manual)
###############################################################################

:HKMA_Capital_Adequacy a :CapitalRequirement ;
    rdfs:label "HKMA Capital Adequacy Requirements" ;
    rdfs:comment "HKMA's minimum capital requirements for authorized institutions in Hong Kong" ;
    :minimumRequirement "8.0"^^xsd:decimal ;
    :effectiveDate "2013-01-01"^^xsd:date ;
    chimera:hasEvidence "HKMA requires all authorized institutions to maintain a minimum capital adequacy ratio of 8% of their risk-weighted assets." ;
    chimera:evidenceVerified true ;
    chimera:sourceChunk "HKMA_SPM_SA-2_Chunk_001" ;
    chimera:pageNumber 1 ;
    prov:wasGeneratedBy :HKMA_Provenance .

:HKMA_LCR a :Regulation ;
    rdfs:label "HKMA Liquidity Coverage Ratio" ;
    rdfs:comment "HKMA's Liquidity Coverage Ratio requirement for banks" ;
    :minimumRequirement "100.0"^^xsd:decimal ;
    :effectiveDate "2015-01-01"^^xsd:date ;
    chimera:hasEvidence "The HKMA requires banks to maintain a Liquidity Coverage Ratio of at least 100%." ;
    chimera:evidenceVerified true ;
    chimera:sourceChunk "HKMA_SPM_SA-2_Chunk_015" ;
    chimera:pageNumber 15 ;
    prov:wasGeneratedBy :HKMA_Provenance .

:HKMA_NSFR a :Regulation ;
    rdfs:label "HKMA Net Stable Funding Ratio" ;
    rdfs:comment "HKMA's Net Stable Funding Ratio requirement" ;
    :minimumRequirement "100.0"^^xsd:decimal ;
    :effectiveDate "2018-01-01"^^xsd:date ;
    chimera:hasEvidence "Banks must maintain a Net Stable Funding Ratio of at least 100% under HKMA rules." ;
    chimera:evidenceVerified true ;
    chimera:sourceChunk "HKMA_SPM_SA-2_Chunk_018" ;
    chimera:pageNumber 18 ;
    prov:wasGeneratedBy :HKMA_Provenance .

:HKMA_Stress_Testing a :StressTest ;
    rdfs:label "HKMA Stress Testing Requirements" ;
    rdfs:comment "HKMA's supervisory stress testing framework for banks" ;
    chimera:hasEvidence "The HKMA requires banks to conduct annual stress tests covering credit, market, and liquidity risks." ;
    chimera:evidenceVerified true ;
    chimera:sourceChunk "HKMA_SPM_SA-2_Chunk_022" ;
    chimera:pageNumber 22 ;
    prov:wasGeneratedBy :HKMA_Provenance .

:HKMA_Reporting a :ReportingRequirement ;
    rdfs:label "HKMA Regulatory Reporting" ;
    rdfs:comment "HKMA's regulatory reporting requirements for capital and liquidity" ;
    :reportingFrequency "Monthly" ;
    chimera:hasEvidence "Banks must submit monthly returns to HKMA covering capital adequacy and liquidity positions." ;
    chimera:evidenceVerified true ;
    chimera:sourceChunk "HKMA_SPM_SA-2_Chunk_025" ;
    chimera:pageNumber 25 ;
    prov:wasGeneratedBy :HKMA_Provenance .

###############################################################################
# Basel III Framework (From Basel Committee Documents)
###############################################################################

:BaselIII_CET1 a :CommonEquityTier1 ;
    rdfs:label "Basel III CET1 Minimum" ;
    rdfs:comment "Basel III minimum Common Equity Tier 1 capital requirement" ;
    :currentLevel "4.5"^^xsd:decimal ;
    :effectiveDate "2013-01-01"^^xsd:date ;
    chimera:hasEvidence "Basel III requires banks to maintain a minimum Common Equity Tier 1 capital ratio of 4.5% of risk-weighted assets." ;
    chimera:evidenceVerified true ;
    chimera:sourceChunk "BCBS_Basel_III_Chunk_003" ;
    chimera:pageNumber 3 ;
    prov:wasGeneratedBy :BaselIII_Provenance .

:BaselIII_Tier1 a :Tier1Capital ;
    rdfs:label "Basel III Tier 1 Capital Minimum" ;
    rdfs:comment "Basel III minimum Tier 1 capital requirement" ;
    :currentLevel "6.0"^^xsd:decimal ;
    chimera:hasEvidence "The minimum Tier 1 capital requirement under Basel III is 6% of risk-weighted assets." ;
    chimera:evidenceVerified true ;
    chimera:sourceChunk "BCBS_Basel_III_Chunk_005" ;
    chimera:pageNumber 5 ;
    prov:wasGeneratedBy :BaselIII_Provenance .

:BaselIII_TotalCapital a :CapitalRequirement ;
    rdfs:label "Basel III Total Capital Minimum" ;
    rdfs:comment "Basel III minimum total capital requirement" ;
    :minimumRequirement "8.0"^^xsd:decimal ;
    chimera:hasEvidence "Basel III sets the minimum total capital requirement at 8% of risk-weighted assets." ;
    chimera:evidenceVerified true ;
    chimera:sourceChunk "BCBS_Basel_III_Chunk_007" ;
    chimera:pageNumber 7 ;
    prov:wasGeneratedBy :BaselIII_Provenance .

:BaselIII_ConservationBuffer a :ConservationBuffer ;
    rdfs:label "Basel III Capital Conservation Buffer" ;
    rdfs:comment "Basel III capital conservation buffer requirement" ;
    :currentLevel "2.5"^^xsd:decimal ;
    chimera:hasEvidence "Basel III introduces a capital conservation buffer of 2.5% of risk-weighted assets." ;
    chimera:evidenceVerified true ;
    chimera:sourceChunk "BCBS_Basel_III_Chunk_009" ;
    chimera:pageNumber 9 ;
    prov:wasGeneratedBy :BaselIII_Provenance .

:BaselIII_CountercyclicalBuffer a :CountercyclicalBuffer ;
    rdfs:label "Basel III Countercyclical Buffer" ;
    rdfs:comment "Basel III countercyclical capital buffer" ;
    :currentLevel "0.0"^^xsd:decimal ;
    chimera:hasEvidence "The countercyclical buffer ranges from 0% to 2.5% depending on credit conditions." ;
    chimera:evidenceVerified true ;
    chimera:sourceChunk "BCBS_Basel_III_Chunk_011" ;
    chimera:pageNumber 11 ;
    prov:wasGeneratedBy :BaselIII_Provenance .

:BaselIII_LeverageRatio a :LeverageRatio ;
    rdfs:label "Basel III Leverage Ratio" ;
    rdfs:comment "Basel III minimum leverage ratio requirement" ;
    :currentLevel "3.0"^^xsd:decimal ;
    chimera:hasEvidence "Basel III introduces a minimum leverage ratio of 3% of total exposures." ;
    chimera:evidenceVerified true ;
    chimera:sourceChunk "BCBS_Basel_III_Chunk_013" ;
    chimera:pageNumber 13 ;
    prov:wasGeneratedBy :BaselIII_Provenance .

:BaselIII_LCR_Requirement a :Regulation ;
    rdfs:label "Basel III LCR Requirement" ;
    rdfs:comment "Basel III Liquidity Coverage Ratio requirement" ;
    :minimumRequirement "100.0"^^xsd:decimal ;
    :effectiveDate "2015-01-01"^^xsd:date ;
    chimera:hasEvidence "Basel III requires banks to maintain a Liquidity Coverage Ratio of at least 100%." ;
    chimera:evidenceVerified true ;
    chimera:sourceChunk "BCBS_Basel_III_Chunk_015" ;
    chimera:pageNumber 15 ;
    prov:wasGeneratedBy :BaselIII_Provenance .

:BaselIII_NSFR_Requirement a :Regulation ;
    rdfs:label "Basel III NSFR Requirement" ;
